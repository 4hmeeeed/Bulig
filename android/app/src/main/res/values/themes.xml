<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare splash theme only. The real theme is Compose's BuligTheme; this
      exists so the window has a background before the first frame draws.
    -->
    <style name="Theme.Bulig" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
